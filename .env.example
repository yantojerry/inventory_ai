# Copy this file to .env and replace the placeholder with your real key.
# Do not commit or share your real .env file.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=inventory_ai
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME

# Optional direct SQLAlchemy URL override:
# INVENTORY_DATABASE_URL=mysql+pymysql://root:CHANGE_ME@127.0.0.1:3307/inventory_ai?charset=utf8mb4

# Optional JWT signing secret. If omitted, the app generates an in-memory secret at startup.
JWT_SECRET=PASTE_A_LONG_RANDOM_SECRET

AI_CHATBOT_PROVIDER=gemini
GEMINI_API_KEY=PASTE_YOUR_NEW_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Optional xAI/Grok alternative:
# AI_CHATBOT_PROVIDER=grok
# GROK_API_KEY=PASTE_YOUR_XAI_KEY_HERE
# GROK_MODEL=grok-4.3
